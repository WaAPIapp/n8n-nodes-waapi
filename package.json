{
  "name": "@waapiapp/n8n-nodes-waapi",
  "version": "1.7.1",
  "description": "n8n community node for the WaAPI messaging API: send and receive messages, manage chats, groups and channels.",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "n8n-node",
    "waapi",
    "messaging",
    "chat",
    "automation",
    "rest-api",
    "webhooks"
  ],
  "license": "MIT",
  "homepage": "https://waapi.app/integrations/n8n",
  "author": {
    "name": "WaAPI",
    "url": "https://waapi.app"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/WaAPIapp/n8n-nodes-waapi.git"
  },
  "engines": {
    "node": ">=18.10",
    "pnpm": ">=9.1"
  },
  "packageManager": "pnpm@9.1.4",
  "main": "index.js",
  "scripts": {
    "build": "node scripts/build-properties.mjs && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "test": "jest",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json --ext .ts,.json",
    "lintfix": "eslint nodes credentials package.json --ext .ts,.json --fix"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/WaapiApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/WaAPI/Waapi.node.js"
    ]
  },
  "devDependencies": {
    "@devlikeapro/n8n-openapi-node": "^0.1.0",
    "@types/jest": "^29.5.12",
    "@typescript-eslint/parser": "^7.15.0",
    "eslint": "^8.56.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.1",
    "gulp": "^4.0.2",
    "jest": "^29.7.0",
    "jsonc-eslint-parser": "^3.3.0",
    "n8n-workflow": "*",
    "prettier": "^3.3.2",
    "ts-jest": "^29.2.5",
    "typescript": "^5.5.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/WaAPIapp/n8n-nodes-waapi/issues"
  }
}
